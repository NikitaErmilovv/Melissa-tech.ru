NEXT_PUBLIC_SITE_URL=https://aliento.dance
DATABASE_URL="file:./dev.db"
SESSION_SECRET="change-me-in-production-use-a-long-random-string"

# Yandex SMTP — подтверждение email при регистрации
# Создайте пароль приложения: Яндекс ID → Безопасность → Пароли приложений
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-mail@yandex.ru
SMTP_PASS=your-app-password
SMTP_FROM=your-mail@yandex.ru
EMAIL_FROM_NAME=Aliento

# ЮKassa — оплата абонементов (самозанятость)
# Личный кабинет: https://yookassa.ru/my/merchant/integration/api-keys
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Для пользовательского соглашения и чеков (необязательно)
LEGAL_OWNER_NAME=
LEGAL_INN=
