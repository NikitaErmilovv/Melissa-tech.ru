# Скопируйте в /opt/autoblesk/.env (или подключите: cat deploy/env.mail.template >> .env)
# Замените ЗАМЕНИТЕ на ваш домен. RESEND_API_KEY — только после resend.com → Domains → Verified.

# Публичный URL CRM (HTTPS после certbot)
PUBLIC_APP_URL=https://crm.ЗАМЕНИТЕ

# Resend API (не публикуйте ключ в git)
RESEND_API_KEY=

# От кого летят письма (домен должен быть верифицирован в Resend)
MAIL_FROM=Авто Блеск <noreply@ЗАМЕНИТЕ>

# Ответы/support (опционально, тот же верифицированный домен)
MAIL_REPLY_TO=support@ЗАМЕНИТЕ

# Подпись в теме и шапке писем
MAIL_BRAND_NAME=Авто Блеск

# --- Типы писем (уже в коде) ---
# registration_verify   — ссылка после /register
# registration_approved — студия одобрена суперадмином
# staff_access          — логин/пароль при выдаче доступа сотруднику (если указан email)
# password_reset        — новый пароль из платформы